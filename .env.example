# ============================================================
# BuildEaze — environment variables
# Copy this file to .env.local (Next.js) or set these in your
# Vercel/Netlify project settings. NEVER commit the real file.
# ============================================================

# --- AI reasoning layer (pick at least one — orchestrator will
#     use whichever is set, in this priority order) -----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=

# Which provider to default to when more than one key is set.
# One of: openai | anthropic | gemini
DEFAULT_AI_PROVIDER=anthropic

# --- Source control / CI --------------------------------------
# Fine-grained PAT with repo + workflow scopes. Used server-side
# only, to open PRs, read Actions run results, and post the
# readiness report back as a PR comment.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=

# --- Backend / data (optional — only if your hackathon project
#     itself needs a database, not required by the orchestrator) -
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Deployment targets (optional — for one-click deploy from
#     the dashboard) --------------------------------------------
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NETLIFY_AUTH_TOKEN=

# --- Security scanning (optional — CodeQL, Dependabot and
#     Gitleaks run for free inside GitHub Actions and need NO
#     key at all. Only set these if you want the hosted/cloud
#     versions instead of the CI-native ones.) -------------------
SNYK_TOKEN=
SEMGREP_APP_TOKEN=

# --- Load/API testing (optional) --------------------------------
K6_CLOUD_TOKEN=
POSTMAN_API_KEY=

# --- App config ---------------------------------------------------
NEXT_PUBLIC_APP_NAME=BuildEaze
NODE_ENV=development
